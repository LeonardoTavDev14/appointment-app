generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum userRoles {
  ADMIN
  USER 
  BARBER
}

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  email String @unique
  password String
  age Int
  role userRoles @default(USER)
  resetToken String?
  resetExpiredToken DateTime?
  loginAttempt Int?
  lockAccount DateTime?
  refreshToken RefreshToken[] @relation("user-refresh-token")
  order Order[] @relation("user-order")
  store Store[] @relation("user-barber")
  created_At DateTime @default(now())
  updated_At DateTime @updatedAt

  @@map("Users-")
}

model RefreshToken {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  expiredIn DateTime
  user User @relation("user-refresh-token", fields: [userId], references: [id])
  userId String @db.ObjectId
  created_At DateTime @default(now())
  updated_At DateTime @updatedAt
}

enum orderStatus {
  PEDDING
  APPROVED
  DENIED
}

model Order {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  description String
  fone String
  observations String?
  status orderStatus @default(PEDDING)
  user User @relation("user-order", fields: [userId], references: [id])
  userId String @db.ObjectId @unique
  timeOrder DateTime @default(now())
  updated_At DateTime @updatedAt

  @@map("Order-")
}

model log {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  action String
  details String
  userId String
  admin String
  observations String?
  created_At DateTime @default(now())
  updated_At DateTime @updatedAt

  @@map("log-")
}

enum operationStatus {
  OPEN 
  CLOSE
}

model Store {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  businessFone String
  cep String
  address String
  operation operationStatus @default(OPEN)
  openingHours String
  closingTime String
  cnpj String?
  user User @relation("user-barber", fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.ObjectId @unique
  service Service[] @relation("store-service")
  created_At DateTime @default(now())
  updated_At DateTime @updatedAt

  @@map("Store-")
}

model Service {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  typeService String
  prices Float
  store Store @relation("store-service", fields: [storeId], references: [id])
  storeId String @db.ObjectId
  observations String?
  created_At DateTime @default(now())
  updated_At DateTime @updatedAt

  @@map("Service-")
}
